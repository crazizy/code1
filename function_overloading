#include <iostream>
using namespace std;
//Function overloading
//Function defination
float add(float i,float j,float k)
{
    return (i+j+k);
   
}
int add(int a,int b)
{
    return (a+b);
   
}
int add(float m,float n)
{
    return (m+n);
   
}
int main()
{
    float a;
    int b,c;
    float x,y,z;
    cout<<"Enter 3 number\n";
    cin>>x>>y>>z;
    a=add(x,y,z);
    b=add(x,y);
    c=add(y,z);
    cout<<"Function values are\n"<<a<<"\n"<<b<<"\n"<<c;
    return 0;
}
