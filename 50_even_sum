#include<iostream>
using namespace std;
int main()
{
   int sumeven=0,sumodd=0,i;
   for(i=1;i<=50;i++)
   {
       if(i%2==0)
       sumeven=sumeven+i;
       else
       sumodd=sumodd+i;
   }
   cout<<"Sum of first 50 even number is"<<sumeven<<endl;
   cout<<"Sum of first 50 odd number is "<<sumodd<<endl;
   return 0;
}
